{
  "name": "cir-cockpit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:error-compliance": "node ./scripts/check-error-compliance.mjs",
    "test": "vitest",
    "test:run": "vitest run --reporter=dot --hideSkippedTests --silent=passed-only",
    "test:changed": "vitest run --changed --reporter=dot --hideSkippedTests --silent=passed-only --passWithNoTests",
    "test:related": "vitest related --run --reporter=dot --hideSkippedTests --silent=passed-only --passWithNoTests",
    "test:coverage": "vitest run --coverage --reporter=dot --hideSkippedTests --silent=passed-only",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
