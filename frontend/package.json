    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "25.0.10",
    "@types/react": "^19.2.18",
