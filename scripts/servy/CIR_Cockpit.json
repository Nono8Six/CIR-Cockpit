{
  "Name": "CIR-Cockpit",
  "DisplayName": "CIR Cockpit",
  "Description": "Frontend Vite CIR Cockpit sur le port 3000",
  "ExecutablePath": "C:\\Program Files\\nodejs\\node.exe",
  "StartupDirectory": "C:\\GitHub\\CIR_Cockpit\\CIR-Cockpit\\frontend",
  "Parameters": "C:\\GitHub\\CIR_Cockpit\\CIR-Cockpit\\frontend\\node_modules\\vite\\bin\\vite.js --host 0.0.0.0 --port 3000 --strictPort",
  "StartupType": 2,
  "Priority": 2,
  "StdoutPath": "C:\\Users\\arnau\\.servy\\logs\\cir-cockpit\\stdout.log",
  "StderrPath": "C:\\Users\\arnau\\.servy\\logs\\cir-cockpit\\stderr.log",
  "StartTimeout": 30,
  "StopTimeout": 15,
  "EnableConsoleUI": false,
  "EnableSizeRotation": true,
  "RotationSize": 10,
  "EnableDateRotation": true,
  "DateRotationType": 0,
  "MaxRotations": 14,
  "UseLocalTimeForRotation": true,
  "EnableDebugLogs": false,
  "EnableHealthMonitoring": true,
  "HeartbeatInterval": 30,
  "MaxFailedChecks": 3,
  "RecoveryAction": 1,
  "RecoveryOnCleanExit": false,
  "MaxRestartAttempts": 5,
  "HeartbeatUrl": "http://127.0.0.1:3000",
  "HeartbeatUrlTimeoutSeconds": 5,
  "EnableHeartbeatUrlFlags": false,
  "ServiceDependencies": "CIR-Cockpit-API"
}
