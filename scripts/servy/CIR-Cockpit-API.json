{
  "Name": "CIR-Cockpit-API",
  "DisplayName": "CIR Cockpit API",
  "Description": "API Node CIR Cockpit (Hono + tRPC) sur le port 8787",
  "ExecutablePath": "C:\\Program Files\\nodejs\\node.exe",
  "StartupDirectory": "C:\\GitHub\\CIR_Cockpit\\CIR-Cockpit\\backend",
  "Parameters": "--env-file=.env --import tsx src/index.ts",
  "StartupType": 2,
  "Priority": 2,
  "StdoutPath": "C:\\GitHub\\CIR_Cockpit\\CIR-Cockpit\\backend\\logs\\api.out.log",
  "StderrPath": "C:\\GitHub\\CIR_Cockpit\\CIR-Cockpit\\backend\\logs\\api.err.log",
  "StartTimeout": 30,
  "StopTimeout": 15,
  "EnableConsoleUI": false,
  "EnableSizeRotation": true,
  "RotationSize": 10,
  "EnableDateRotation": true,
  "DateRotationType": 0,
  "MaxRotations": 14,
  "UseLocalTimeForRotation": true,
  "EnableDebugLogs": false,
  "EnableHealthMonitoring": true,
  "HeartbeatInterval": 30,
  "MaxFailedChecks": 3,
  "RecoveryAction": 1,
  "RecoveryOnCleanExit": false,
  "MaxRestartAttempts": 5,
  "HeartbeatUrl": "http://127.0.0.1:8787/health",
  "HeartbeatUrlTimeoutSeconds": 5,
  "EnableHeartbeatUrlFlags": false
}
