{
  "name": "@cir-cockpit/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#test/assert": "./src/test/assert.ts"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --reporter=dot --silent=passed-only",
    "test:changed": "vitest run --changed --reporter=dot --silent=passed-only --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=dot --silent=passed-only",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/mistral": "4.0.29",
    "@hono/node-server": "1.19.11",
    "@hono/trpc-server": "0.4.2",
    "@supabase/supabase-js": "2.112.3",
    "@trpc/server": "11.18.0",
    "ai": "7.0.66",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.2",
    "hono": "4.13.0",
    "jose": "5.9.6",
    "postgres": "3.4.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "xlsx": "0.18.5"
  }
}
